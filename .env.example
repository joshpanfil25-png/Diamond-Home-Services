# Lead form destination — /api/lead tries these in order:

# 1. Webhook (Zapier / Make / CRM webhook, e.g. JobNimbus or AccuLynx inbound
#    webhook). The validated lead JSON is POSTed here.
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXX/XXXX/

# 2. Resend email fallback — used only when LEAD_WEBHOOK_URL is unset.
#    Sends a formatted lead email to LEAD_TO_EMAIL.
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
# LEAD_TO_EMAIL=info@diamondhomeservice.com

# If neither is configured, leads are logged to the server console (dev only).
